{
	"1": {
		"height_offset": -0.2,
		"interaction_text": "Fishy? Or sofishticated?",
		"movement": {
			"preset": "random",
			"range": [
				2.0,
				2.0
			]
		},
		"movement_mode": "swimming",
		"sprite": "Sylvafin",
		"type": "fakemon"
	},
	"10": {
		"interaction_text": "Why hello, are you here for the Professor?\nThat doesn't really help me narrow it down for you. What is the department?",
		"sprite": "Scientist",
		"type": "human"
	},
	"11": {
		"hidden": true,
		"interaction_text": "",
		"sprite": "Professor",
