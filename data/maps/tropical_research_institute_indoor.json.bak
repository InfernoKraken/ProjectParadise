		{
			"asset_path": "res://assets/overworld/indoor_display_00.png",
			"height": 1.0,
			"interaction_text": "Jalovea is home an immense number of plant and animal species, some of which are the creatures known as Fakemon. The Tropical Research Institute conducts studies and develops solutions related to the preservation and care of this complex ecosystem.",
			"position": [
				4.0,
				0.0,
				0.5
			],
			"size": [
				1.0,
				1.0,
				1.0
			],
			"type": "asset.indoor_display",
			"variant": 0
		},
		{
			"asset_path": "res://assets/overworld/indoor_display_01.png",
			"height": 1.0,
			"interaction_text": "Jalovea is home to an incredible variety of plant and insect species. Some non-insect or plant species may mimic insects or plants as a key survival strategy.",
			"position": [
				5.75,
				0.0,
				0.5
			],
			"size": [
				1.0,
				1.0,
