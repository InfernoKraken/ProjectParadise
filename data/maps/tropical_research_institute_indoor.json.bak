		},
		{
			"asset_path": "res://assets/overworld/indoor_billboard_tropical_research.png",
			"height": 2.0,
			"interaction_text": "A collection of charts, data, and academic writing. There are even p-values comparing different variables.\nYou decide you don't miss school that much.",
			"position": [
				5.25,
				0.0,
				-4.30000019073486
			],
			"size": [
				1.0,
				1.0,
				1.0
			],
			"type": "asset.indoor_billboard_tropical_research"
		},
		{
			"asset_path": "res://assets/overworld/indoor_display_02.png",
			"height": 1.0,
			"interaction_text": "Located as a isthmus between two large oceans, Jalovea's ecology is further stressed in some regions by imported species. Though poaching native species has long been made illegal, restoration efforts face additional pressures from hardier, externally native species. Thanks in part to the efforts of this institute, conservation has been widely successful in the regions around Jalovea City.",
			"position": [
				7.5,
				0.0,
				0.5
			],
			"size": [
