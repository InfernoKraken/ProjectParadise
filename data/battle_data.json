  "fakemon": [
	{ "name": "Scorchick", "art_id": "Scorchick", "male_ratio": 0.5, "type": "Fire", "moves": ["squawk", "ignite", "peck", "mimic"], "learnset": [{"move": "squawk", "level": 1}, {"move": "ignite", "level": 2}, {"move": "peck", "level": 3}, {"move": "mimic", "level": 5}, {"move": "scratch", "level": 7}, {"move": "heat_up", "level": 12}, {"move": "singe", "level": 17}, {"move": "intercept", "level": 20}, {"move": "fire_charge", "level": 22}, {"move": "nest", "level": 25}, {"move": "fireheart", "level": 27}, {"move": "whirlwind", "level": 30}, {"move": "wingbeat", "level": 33}, {"move": "burn_off", "level": 36}, {"move": "skyfall", "level": 38}, {"move": "phoenix_charge", "level": 40}, {"move": "challenging_call", "level": 42}, {"move": "harsh_sunlight", "level": 45}, {"move": "inferno_plume", "level": 50}, {"move": "inner_focus", "level": 55}, {"move": "inferno", "level": 60}], "level": 5, "max_hp": 55, "attack": 70, "defense": 50, "special_attack": 40, "special_defense": 45, "speed": 50, "color": "e45b5b", "size": "0.6 m", "description": "A cheery rainforest Fakemon, Scorchick's feathers glow with heat. Their sweet natured personalities and strong verbal communication skills help them form close bonds with parents, trainers and other nest mates. Scorchick love spicy peppers, and can be a pest to growers that specialize in these fruits. It's thought that the capsaicin is related to the chemical reaction required to power their flames, which ignite the wings, tail and tuft of the Fakemon without harming the chick itself. Don't be deceived by the cute Fakemon however, the fires ignited are hot enough to melt iron.", "catch_rate": 75, "base_exp": 64 },
	{ "name": "Sylvafin", "art_id": "Sylvafin", "male_ratio": 0.5, "type": "Water", "moves": ["peck", "soak", "flutter", "photon_beam"], "learnset": [{"move": "peck", "level": 1}, {"move": "soak", "level": 2}, {"move": "flutter", "level": 3}, {"move": "photon_beam", "level": 5}, {"move": "flip_turn", "level": 7}, {"move": "discern", "level": 9}, {"move": "purify", "level": 13}, {"move": "fin_flash", "level": 15}, {"move": "aqua_jet", "level": 20}, {"move": "dazzle", "level": 23}, {"move": "brilliant_light", "level": 25}, {"move": "veil", "level": 27}, {"move": "disable", "level": 30}, {"move": "prayer", "level": 32}, {"move": "scald", "level": 35}, {"move": "smite", "level": 40}, {"move": "aureal_flood", "level": 45}, {"move": "remembrance", "level": 50}, {"move": "celestial_chorus", "level": 55}], "level": 5, "max_hp": 55, "attack": 35, "defense": 50, "special_attack": 65, "special_defense": 65, "speed": 40, "color": "5596e6", "size": "0.7 m", "description": "These rare and graceful Fakemon inhabit the warmest and most heavily planted bodies of water in the rainforest. Sylvafin carry themselves with a sense of dignity and grace - until it is feeding time. In this instance, they become quite the little beggars, forgetting to act the part of an elitist. Their scales reflect sunlight, and perhaps something deeper, causing the Fakemon to glow. It's methods baffle scientists, who have recently discovered that the source of the glow has nothing to do with bioluminescence, as if the source of the glow cannot be explained by the natural world alone. The trusting disposition and rarity of these Fakemon makes conducting any studies extremely unpopular with most people.", "catch_rate": 75, "base_exp": 64 },
	{ "name": "Keklid", "art_id": "Keklid", "male_ratio": null, "type": "Plant", "moves": ["petal_whip", "charm", "stare", "mind_wave"], "learnset": [{"move": "petal_whip", "level": 1}, {"move": "charm", "level": 2}, {"move": "stare", "level": 3}, {"move": "mind_wave", "level": 5}, {"move": "constrict", "level": 7}, {"move": "flutter", "level": 11}, {"move": "drain", "level": 13}, {"move": "remedy", "level": 15}, {"move": "vicegrip", "level": 17}, {"move": "mind_bolt", "level": 20}, {"move": "bloom", "level": 22}, {"move": "seed", "level": 25}, {"move": "regrow", "level": 28}, {"move": "mycelial_hunt", "level": 32}, {"move": "drain_toxin", "level": 35}, {"move": "rootmind", "level": 37}, {"move": "synaptic_bloom", "level": 40}, {"move": "hysteria", "level": 42}, {"move": "chlorophyll_cannon", "level": 45}, {"move": "vital_cognition", "level": 50}], "level": 5, "max_hp": 55, "attack": 35, "defense": 50, "special_attack": 70, "special_defense": 60, "speed": 40, "color": "55c878", "size": "0.5 m", "description": "A rare and wild wonder, Keklid require extremely precise temperatures, humidity and fungal conditions to germinate from tiny seeds. Such conditions can only exist in the deep lowland rainforests and only under a seed's exposure to a specific fungal host. Upon hatching however, they voraciously seek out fungal colonies to feast on mycelium. It's thought that the fungal networks not only power the flower's own metabolism, but that it also has the unusual effect of granting the Fakemon a type of non-animal cognition as well. These Fakemon are generally described as joyous, but fail to thrive in cooler or drier conditions.", "catch_rate": 75, "base_exp": 64 },
	{ "name": "Plain Square", "male_ratio": 0.5, "type": "Normal", "moves": ["pounce", "quick_bump", "restore"], "level": 5, "max_hp": 35, "attack": 15, "defense": 15, "special_attack": 15, "special_defense": 15, "speed": 15, "color": "c4b9a8", "size": "0.65 m", "description": "An adaptable Fakemon seen throughout Paradise. Its unassuming shape hides sharp senses and a playful habit of copying the movement of nearby creatures.", "catch_rate": 200, "base_exp": 55 },
	{ "name": "Gleam Square", "male_ratio": null, "type": "Light", "moves": ["radiant_jolt", "sunbeam", "purify", "charm_ray"], "level": 5, "max_hp": 34, "attack": 16, "defense": 14, "special_attack": 18, "special_defense": 15, "speed": 18, "color": "d4aa24", "size": "0.55 m", "description": "It bends scattered sunlight into a warm glow. Gleam Squares are often seen hovering beneath gaps in the rainforest canopy after storms.", "catch_rate": 200, "base_exp": 55 },
	{ "name": "Gloom Square", "male_ratio": 0.5, "type": "Dark", "moves": ["nightmare_nudge", "shadow_snap", "absolve", "sentence", "dread_glare"], "level": 5, "max_hp": 36, "attack": 16, "defense": 15, "special_attack": 17, "special_defense": 16, "speed": 13, "color": "57456f", "size": "0.7 m", "description": "It settles into deep shade and muffles the sounds around it. Its edges become difficult to distinguish when the canopy blocks the moon.", "catch_rate": 200, "base_exp": 55 }
  ]
}
