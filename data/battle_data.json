    { "name": "Plain Square", "gender": "Female", "type": "Normal", "moves": ["pounce", "quick_bump", "restore"], "level": 5, "max_hp": 35, "attack": 15, "defense": 15, "special_attack": 15, "special_defense": 15, "speed": 15, "color": "c4b9a8", "size": "0.65 m", "description": "An adaptable Fakemon seen throughout Paradise. Its unassuming shape hides sharp senses and a playful habit of copying the movement of nearby creatures.", "catch_rate": 200, "base_exp": 55 },
