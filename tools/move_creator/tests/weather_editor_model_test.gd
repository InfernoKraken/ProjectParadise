extends SceneTree

func _initialize() -> void:
	var visuals_path := "user://weather_editor_visuals.json"
	var battle_path := "user://weather_editor_battle.json"
	var file := FileAccess.open(visuals_path, FileAccess.WRITE); file.store_string(FileAccess.get_file_as_string("res://data/weather_visuals.json")); file.close()
	file = FileAccess.open(battle_path, FileAccess.WRITE); file.store_string(FileAccess.get_file_as_string("res://data/battle_data.json")); file.close()
	var model := WeatherEditorModel.new(); assert(model.load_data(visuals_path, battle_path) == OK)
	assert(WeatherEditorModel.turns_text(3.0) == "3.0" and WeatherEditorModel.turns_text([2, 3]) == "[2,3]", "Turn display must safely format scalar and array Variants without typed String constructors.")
	assert(model.select_weather("Celestial Chorus") and model.definition()["background_overlay"]["turns"] is int, "Integral JSON turn numbers must normalize to canonical integers when data loads.")
	assert(model.select_weather("Rootmind") and model.duration() == 3, "Duration must come from canonical battle data.")
	var overlay: Dictionary = model.definition()["background_overlay"]; model.selected_category = "background_overlay"; model.selected_element = overlay; model.set_element_field("scale", 1.25); assert(overlay["scale"] == 1.25 and model.validation_errors().is_empty(), "Background overlay scale must be canonically authorable.")
	var sprite := model.add_element("sprite_effect"); sprite["turns"] = [1,3]; assert(model.validation_errors().is_empty())
	model.set_element_field("turns", "[2, 3]"); assert(sprite["turns"] is Array and sprite["turns"] == [2, 3], "Turn input must be normalized before comparison and storage."); model.set_element_field("turns", "2"); assert(sprite["turns"] is int and sprite["turns"] == 2, "Single turn input must be stored as an integer."); model.set_element_field("turns", "all"); assert(sprite["turns"] == "all", "All-turn input must use the canonical token."); model.set_element_field("turns", [1, 3])
	model.set_duration(2); assert(not model.validation_errors().is_empty(), "Reducing duration must surface invalid turn references.")
	model.set_duration(5); assert(model.validation_errors().is_empty()); assert(model.save(visuals_path, battle_path) == OK)
	var reloaded := WeatherEditorModel.new(); assert(reloaded.load_data(visuals_path, battle_path) == OK and reloaded.select_weather("Rootmind")); var saved_turns: Array = reloaded.definition()["sprite_effects"][-1]["turns"]; assert(reloaded.duration() == 5 and int(saved_turns[0]) == 1 and int(saved_turns[1]) == 3, "Weather visuals and canonical duration must round-trip.")
	assert(reloaded.create_weather("Test Weather").is_empty() and reloaded.duration() == 3, "New weather must use the canonical default duration.")
	assert(not reloaded.eligible_move_ids().is_empty()); var invalid_move := "absorb"; assert(not reloaded.assign_to_move(invalid_move), "Moves without sets_weather must be blocked.")
	var offset_sprite := reloaded.add_element("sprite_effect"); assert(offset_sprite["x_offset"] == 0.0 and offset_sprite["y_offset"] == 0.0, "Spatial elements must default canonical offsets to zero.")
	assert(WeatherEditorModel.LIGHT_TYPES.has("heat_shimmer") and WeatherEditorModel.LIGHT_TYPES.has("particles"), "All runtime procedural light types must be authorable.")
	assert(reloaded.copy_selected() and reloaded.paste_copied(), "Selected elements must support copy and paste."); var pasted := reloaded.selected_element; pasted["x_offset"] = 99; assert(offset_sprite["x_offset"] == 0.0, "Pasted elements must be independent deep copies.")
	assert(reloaded.undo_element_change() and reloaded.definition()["sprite_effects"].find(pasted) < 0, "Undo must restore the weather definition before paste.")
	var particle := reloaded.add_element("particle_effect"); assert(particle["type"] == "particle" and particle["emitter_mode"] == "anchored" and particle["offscreen_margin"] == 32.0 and particle.has("particle_sprite") and particle.has("emit_rate") and particle.has("emitter_anchor") and particle.has("movement_mode") and particle.has("rotation_mode"), "Particle elements must use the canonical runtime schema.")
	assert(reloaded.elements().any(func(entry): return entry["category"] == "particle_effect" and is_same(entry["element"], particle)), "Particle elements must appear in the editable element list.")
	assert(WeatherEditorModel.particle_emitter_mode({"emitter_space":"global"}) == "screen" and WeatherEditorModel.particle_emitter_mode({"emitter_space":"position"}) == "anchored" and WeatherEditorModel.particle_movement_mode({"movement_mode":"horizontal"}) == "right", "Legacy particle aliases must resolve to their canonical editor values.")
	assert(not reloaded.overlay_assets().is_empty() and reloaded.overlay_assets()[0].begins_with(WeatherEditorModel.WEATHER_ASSET_DIR) and reloaded.sprite_families().has("sprite_example"), "Weather asset controls must discover overlays and indexed sprite families from the canonical weather directory.")
	reloaded.set_particle_emitter_mode("screen"); assert(particle["emitter_mode"] == "screen" and not particle.has("emitter_space"), "Changing emitter mode must write only the canonical field.")
	particle["flicker_enabled"] = true; particle["flicker_type"] = "individual"; particle["flicker_min_alpha"] = 0.2; particle["flicker_max_alpha"] = 0.8; particle["flicker_interval"] = 0.5; assert(reloaded.validation_errors().is_empty(), "Canonical particle flicker fields must be accepted by the editor model.")
	var canonical_sprite := reloaded.add_element("sprite_effect"); reloaded.set_element_field("sprite_mode", "scrolling"); reloaded.set_element_field("scroll_direction", "right"); reloaded.set_element_field("scroll_speed", 40.0); reloaded.set_element_field("transition_overlap", 3.0); reloaded.set_element_field("opacity", 0.6); reloaded.set_element_field("mirror_x", true); reloaded.set_element_field("fade_out_duration", 0.3); reloaded.set_sprite_fade_cause("duration", true); reloaded.set_element_field("visible_duration", 1.0); assert(canonical_sprite["sprite_mode"] == "scrolling" and canonical_sprite["fade_out_causes"].has("duration"), "Canonical scrolling and fade lifecycle fields must be directly authorable.")
	var signal_sprite := reloaded.add_element("sprite_effect"); reloaded.set_element_field("mode", "persistent"); reloaded.set_element_field("signal_enabled", true); reloaded.set_element_field("signal_min_alpha", 0.1); reloaded.set_element_field("signal_max_alpha", 0.6); reloaded.set_element_field("signal_rise_time", 0.28); reloaded.set_element_field("signal_fall_time", 0.7); reloaded.set_element_field("signal_interval", 2.8); reloaded.set_element_field("signal_delay", 0.32); assert(reloaded.validation_errors().is_empty() and signal_sprite["signal_rise_time"] == 0.28 and signal_sprite["signal_fall_time"] == 0.7, "Every canonical Rootmind signal property must be authorable.")
	reloaded.set_element_field("rotation", 12.0); reloaded.set_element_field("thought_id", "A"); reloaded.set_element_field("thought_low_alpha", 0.08); reloaded.set_element_field("thought_high_alpha", 0.48); assert(reloaded.validation_errors().is_empty(), "Canonical Rootmind thought-target sprite fields must be authorable.")
	var thought_sequence := reloaded.add_element("thought_sequence"); thought_sequence["initial_delay"] = 2.8; thought_sequence["interval"] = 4.6; thought_sequence["sequences"] = [[{"targets":["A"], "duration":0.28}], [{"targets":["A"], "duration":0.7, "particle_effect":0, "particle_count":5}]]; assert(reloaded.validation_errors().is_empty() and reloaded.elements().any(func(entry): return entry["category"] == "thought_sequence"), "Canonical weather thought sequences must be editable and valid.")
	var beam := reloaded.add_element("lighting_effect"); beam["type"] = "beam"; beam["x_offset"] = 9.0; reloaded.set_element_field("start_x_offset", 12.0); assert(beam["start_x_offset"] == 12.0 and not beam.has("x_offset"), "Editing beam start offsets must write the preferred runtime key and remove its legacy alias.")
	print("WEATHER_EDITOR_MODEL_TEST_PASSED"); quit()
