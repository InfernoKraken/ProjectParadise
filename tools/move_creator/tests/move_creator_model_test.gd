extends SceneTree

func _initialize()->void:
	var temp_path:="user://move_creator_battle_data.json";var source_text:=FileAccess.get_file_as_string("res://data/battle_data.json");var temp:=FileAccess.open(temp_path,FileAccess.WRITE);temp.store_string(source_text);temp.close()
	var model:=MoveCreatorModel.new();assert(model.load_database(temp_path)==OK,"Canonical battle data must load.");var ids:=model.move_ids();assert(ids.has("pounce") and ids.has("grand_display"),"Move discovery must find simple and complex moves.")
	model.data["moves"]["missing_description_test"]={"name":"Missing Description Test","power":0,"type":"Normal","damage_class":"Status"};assert(model.missing_description_move_ids().has("missing_description_test"),"Moves without descriptions must be reported.");model.data["moves"].erase("missing_description_test")
	assert(model.select_move("pounce"));assert(model.selected_move["name"]=="Pounce" and int(model.selected_move["power"])==40 and model.selected_move["damage_class"]=="Physical");assert(model.selected_move["fallback_animation"]=="caster_lunge","Legacy animation_kind must display as canonical fallback.")
	assert(model.apply_additional_fields_json('{"custom_effect":{"kind":"test","amount":2}}').is_empty() and model.selected_move["custom_effect"]["amount"]==2,"Editable additional JSON must attach arbitrary nested effect fields to a move.");assert(not model.apply_additional_fields_json('{"name":"Bypass"}').is_empty(),"Additional JSON must not overwrite structured fields.");assert(not model.apply_raw_move_json("[]").is_empty(),"Raw move JSON must require an object.")
	var animation_ids:PackedStringArray=MoveAnimationEditorModel.new().discover_animations()["ids"];assert(animation_ids.has("projectile_test"))
	model.set_field("name","Pounce Edited");model.set_field("description","A focused regression-test description.");model.set_field("power",45);model.set_field("type","Fighting");model.set_field("damage_class","Special");model.set_field("animation_id","projectile_test");model.set_field("fallback_animation","projectile");assert(model.validation_errors(animation_ids).is_empty());assert(model.save(animation_ids)==OK)
	var reloaded:=MoveCreatorModel.new();assert(reloaded.load_database(temp_path)==OK and reloaded.select_move("pounce"));assert(reloaded.selected_move["name"]=="Pounce Edited" and reloaded.selected_move["description"]=="A focused regression-test description." and int(reloaded.selected_move["power"])==45 and reloaded.selected_move["type"]=="Fighting" and reloaded.selected_move["damage_class"]=="Special");assert(reloaded.selected_move["animation_id"]=="projectile_test" and reloaded.selected_move["fallback_animation"]=="projectile");assert(not reloaded.selected_move.has("animation_kind"),"Canonical save must migrate deprecated animation_kind.")
	reloaded.set_field("animation_id",null);assert(not reloaded.selected_move.has("animation_id"),"None must remove animation_id.")
	assert(reloaded.select_move("grand_display"));var reactive_class:Variant=reloaded.selected_move["reactive_poison_damage_class"];var reactive_turns:Variant=reloaded.selected_move["reactive_poison_turns"];var original_changes:Array=reloaded.selected_move["stat_changes"].duplicate(true);assert(reloaded.unknown_fields().has("reactive_poison_turns"),"Complex engine fields must be shown as additional fields.");reloaded.set_field("name","Grand Display Edited");assert(reloaded.save(animation_ids)==OK)
	var complex_roundtrip:=MoveCreatorModel.new();complex_roundtrip.load_database(temp_path);complex_roundtrip.select_move("grand_display");assert(complex_roundtrip.selected_move["reactive_poison_damage_class"]==reactive_class and complex_roundtrip.selected_move["reactive_poison_turns"]==reactive_turns and complex_roundtrip.selected_move["stat_changes"]==original_changes,"Editing known fields must preserve specialized fields.")
	complex_roundtrip.set_field("condition","Burned");complex_roundtrip.set_field("condition_chance",0.2);complex_roundtrip.add_stat_change("defense",-0.1);var added_count:int=complex_roundtrip.selected_move["stat_changes"].size();complex_roundtrip.remove_stat_change(added_count-1);assert(complex_roundtrip.selected_move["stat_changes"].size()==added_count-1);complex_roundtrip.add_stat_change("defense",-0.1);assert(complex_roundtrip.save(animation_ids)==OK)
	var condition_roundtrip:=MoveCreatorModel.new();condition_roundtrip.load_database(temp_path);condition_roundtrip.select_move("grand_display");assert(condition_roundtrip.selected_move["condition"]=="Burned" and is_equal_approx(condition_roundtrip.selected_move["condition_chance"],0.2));assert(condition_roundtrip.selected_move["stat_changes"][-1]=={"stat":"defense","amount":-0.1},"Stat changes must round-trip.")
	var duplicate_errors:=condition_roundtrip.create_move("pounce","Duplicate","Normal","Physical");assert(not duplicate_errors.is_empty(),"Duplicate IDs must be rejected.")
	var original_existing:Dictionary=condition_roundtrip.data["moves"]["pounce"].duplicate(true);assert(condition_roundtrip.create_move("ignite_test","Ignite Test","Fire","Special").is_empty());condition_roundtrip.set_field("power",40);condition_roundtrip.set_field("condition","Burned");condition_roundtrip.set_field("condition_chance",0.2);condition_roundtrip.set_field("animation_id","projectile_test");condition_roundtrip.set_field("fallback_animation","target_burst");assert(condition_roundtrip.save(animation_ids)==OK,"A new move must save without JSON editing.")
	var new_roundtrip:=MoveCreatorModel.new();new_roundtrip.load_database(temp_path);assert(new_roundtrip.data["moves"].has("ignite_test") and new_roundtrip.data["moves"]["pounce"]==original_existing,"Adding a move must not overwrite existing moves.");new_roundtrip.select_move("ignite_test");assert(new_roundtrip.selected_move["animation_id"]=="projectile_test" and new_roundtrip.selected_move["condition"]=="Burned")
	new_roundtrip.set_field("animation_id","missing_animation");assert(not new_roundtrip.validation_errors(animation_ids).is_empty(),"Missing custom animation references must be reported.");new_roundtrip.set_field("animation_id","projectile_test")
	var animation_before:=FileAccess.get_file_as_string("res://data/move_animations/projectile_test.json");assert(new_roundtrip.save(animation_ids)==OK);assert(FileAccess.get_file_as_string("res://data/move_animations/projectile_test.json")==animation_before,"Saving move data must not rewrite animation data.")
	var move_before:=FileAccess.get_file_as_string(temp_path);var animation_copy:=MoveAnimationDefinition.load_file("res://data/move_animations/projectile_test.json");assert(animation_copy.save_file("user://move_creator_animation_isolation.json")==OK);assert(FileAccess.get_file_as_string(temp_path)==move_before,"Saving animation data must not rewrite move data.")
	assert(new_roundtrip.animation_reference_count("projectile_test", "ignite_test")>=1,"Reference counting must detect a shared animation before deletion.")
	assert(new_roundtrip.delete_selected_move()==OK,"Selected move deletion must persist successfully.");var deletion_roundtrip:=MoveCreatorModel.new();assert(deletion_roundtrip.load_database(temp_path)==OK);assert(not deletion_roundtrip.data["moves"].has("ignite_test"),"Deleted move must be removed from the canonical moves object.");assert(deletion_roundtrip.animation_reference_count("projectile_test")>=1,"Deleting one move must preserve other references to its animation.")
	deletion_roundtrip.data["moves"]["orphan_owner"]={"name":"Orphan Owner","power":0,"type":"Fire","damage_class":"Status","animation_id":"orphan_animation"};assert(deletion_roundtrip.select_move("orphan_owner"));assert(deletion_roundtrip.animation_reference_count("orphan_animation","orphan_owner")==0,"A uniquely referenced animation must be identified as orphaned when its owner is excluded.");assert(deletion_roundtrip.delete_selected_move()==OK)
	print("MOVE_CREATOR_MODEL_TEST_PASSED");quit()
